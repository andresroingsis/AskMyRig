<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>AskMyRig.Ingestion</RootNamespace>
		<UserSecretsId>64233ed6-e231-4190-aaab-5bc4ef817d76</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<!-- Token counting that matches what the embedding model does. The Data
         package ships the cl100k_base vocabulary so nothing is downloaded at
         runtime - without it, CreateForModel throws. -->
		<PackageReference Include="Dapper" Version="2.1.79" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
		<PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
		<PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="2.0.0" />
		<PackageReference Include="PdfPig" Version="0.1.16" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\AskMyRig.Core\AskMyRig.Core.csproj" />
	</ItemGroup>

</Project>
